      "name": "Authentication",
      "description": {
        "content": "OAuth 2.0 token generation for Checkout, Payouts, and Reconciliation.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "d2604fa0-884d-448e-95ae-f62213dfb3b7",
          "name": "Generate an OAuth access token.",
          "request": {
            "name": "Generate an OAuth access token.",
            "description": {
              "content": "Exchange clientId, clientSecret, and merchantId for a short-lived Bearer access_token used by the Checkout, Payouts, and Reconciliation APIs. Sandbox host sandbox-dashboard.peachpayments.com; live host dashboard.peachpayments.com.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "oauth",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"<string>\",\n  \"clientSecret\": \"<string>\",\n  \"merchantId\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
