      "item": [
        {
          "id": "e2ff8d67-9d7b-45bd-9d4a-6f120e5f157f",
          "name": "Initiate a debit transaction.",
          "request": {
            "name": "Initiate a debit transaction.",
            "description": {
              "content": "Initiate a server-to-server debit (paymentType DB) or refund (paymentType RF). Certain parameters are required per payment brand. Local brands include PayShap (bank-to-bank instant EFT), Capitec Pay, 1Voucher (voucher PIN), Mobicred (revolving credit), RCS (store card), M-PESA (Kenya mobile money, integer amounts only), blink by Emtel and MCB Juice (Mauritius wallets), Nedbank Direct EFT, Peach EFT, Payflex, ZeroPay, Float, Happy Pay, Scan to Pay, MoneyBadger, and MauCAS. Authentication is an inline object (userId, password, entityId).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "payments"
              ],
              "host": [
                "{{payments-Url}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"authentication\": {\n    \"userId\": \"<string>\",\n    \"password\": \"<string>\",\n    \"entityId\": \"<string>\"\n  },\n  \"merchantTransactionId\": \"<string>\",\n  \"amount\": \"<string>\",\n  \"currency\": \"<string>\",\n  \"paymentBrand\": \"<string>\",\n  \"paymentType\": \"<string>\",\n  \"shopperResultUrl\": \"<uri>\",\n  \"virtualAccount\": {\n    \"bank\": \"<string>\",\n    \"type\": \"<string>\",\n    \"accountId\": \"<string>\",\n    \"password\": \"<string>\"\n  },\n  \"customer\": \"<object>\",\n  \"billing\": \"<object>\",\n  \"shipping\": \"<object>\",\n  \"cart\": \"<object>\"\n}",
